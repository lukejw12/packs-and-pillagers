{
  "type": "minecraft:multi_action",
  "title": {
    "text": "Multiplayer",
    "color": "gold",
    "bold": true
  },
  "external_title": {
    "text": "Multiplayer"
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "width": 330,
