      }
    },
    {
      "label": [
        {
          "text": ""
        },
        {
          "text": "",
          "font": "pnp:menu"
        },
        {
          "text": "  Individual Boards"
        }
      ],
      "tooltip": {
        "text": "Everyone builds their own table."
      },
      "width": 230,
      "action": {
        "type": "minecraft:run_command",
        "command": "/trigger pnp.menu set 3"
      }
    },
    {
      "label": [
        {
          "text": ""
        },
        {
          "text": "",
          "font": "pnp:menu"
        },
        {
          "text": "  PvP"
        }
      ],
      "tooltip": {
        "text": "Your own tables. Send fighters through portals to raid other players."
      },
      "width": 230,
      "action": {
        "type": "minecraft:run_command",
        "command": "/trigger pnp.menu set 4"
