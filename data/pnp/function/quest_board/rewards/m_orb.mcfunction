$tellraw @a[scores={pnp.tpid=$(p)}] [{text:"✔ ",extra:[{translate:"pnp.quest_board.quest_complete",fallback:"Quest complete:"}," "], color: "gold"},{translate:"pnp.card.summoning_orb.name",fallback:"Summoning Orb", color: "white"},{text:"  ",extra:[{translate:"pnp.quest_board.reward_golden_apple",fallback:"Reward: Golden Apple"}], color: "gray"}]
$tellraw @a[scores={pnp.tpid=$(p)}] [{text:"",extra:[{translate:"pnp.quest_board.next",fallback:"Next:"}," "], color: "yellow"},{translate:"pnp.quest_board.awakening",fallback:"Awakening", color: "white"},{text:" ",extra:[{translate:"pnp.quest_board.stack_the_core_and_orb_together",fallback:"- Stack the Core and Orb together"}], color: "gray"}]
