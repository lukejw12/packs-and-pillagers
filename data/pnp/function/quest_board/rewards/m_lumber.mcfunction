$execute in pnp:board positioned $(x).5 65.01 20.5 run function pnp:card/pop {card:"humble_pack"}
$tellraw @a[scores={pnp.tpid=$(p)}] [{text:"✔ ",extra:[{translate:"pnp.quest_board.quest_complete",fallback:"Quest complete:"}," "], color: "gold"},{translate:"pnp.quest_board.lumber",fallback:"Lumber", color: "white"},{text:"  ",extra:[{translate:"pnp.quest_board.reward_humble_pack",fallback:"Reward: Humble Pack"}], color: "gray"}]
$tellraw @a[scores={pnp.tpid=$(p)}] [{text:"",extra:[{translate:"pnp.quest_board.next",fallback:"Next:"}," "], color: "yellow"},{translate:"pnp.quest_board.stone",fallback:"Stone", color: "white"},{text:" ",extra:[{translate:"pnp.quest_board.hand_in_8_cobblestone",fallback:"- Hand in 8 Cobblestone"}], color: "gray"}]
$execute as @a[scores={pnp.tpid=$(p)}] at @s run playsound minecraft:ui.toast.challenge_complete master @s ~ ~ ~ 0.5 1.4
